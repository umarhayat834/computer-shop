{
  "sections": {
    "main": {
      "type": "main-product-umar",
      "blocks": {
        "flags": { "type": "umar_flags", "settings": {} },
        "title": { "type": "title", "settings": {} },
        "meta": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "price": { "type": "price", "settings": {} },
        "qspecs": { "type": "umar_qspecs", "settings": {} },
        "variant": { "type": "variant_picker", "settings": { "picker_type": "button" } },
        "buy": {
          "type": "buy_buttons",
          "settings": { "show_dynamic_checkout": true, "show_gift_card_recipient": false }
        },
        "anydesk": { "type": "umar_anydesk", "settings": {} },
        "assurance": { "type": "umar_assurance", "settings": {} },
        "desc": { "type": "description", "settings": {} }
      },
      "block_order": [
        "flags",
        "title",
        "meta",
        "price",
        "qspecs",
        "variant",
        "buy",
        "anydesk",
        "assurance",
        "desc"
      ],
      "settings": {
        "enable_sticky_info": true,
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "media_position": "left",
        "image_zoom": "none",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "specs": {
      "type": "umar-product-specs",
      "settings": {}
    },
    "condition": {
      "type": "umar-product-condition",
      "blocks": {
        "c1": {
          "type": "row",
          "settings": { "panel": "condition", "label": "Chassis", "value": "No dents" }
        },
        "c2": {
          "type": "row",
          "settings": { "panel": "condition", "label": "Screen", "value": "No marks" }
        },
        "c3": {
          "type": "row",
          "settings": { "panel": "condition", "label": "Keyboard & trackpad", "value": "Original" }
        },
        "c4": {
          "type": "row",
          "settings": { "panel": "condition", "label": "Ports", "value": "All tested" }
        },
        "a1": {
          "type": "row",
          "settings": { "panel": "assurance", "label": "Warranty", "value": "30-day workshop" }
        },
        "a2": {
          "type": "row",
          "settings": { "panel": "assurance", "label": "Returns", "value": "14 days" }
        },
        "a3": {
          "type": "row",
          "settings": { "panel": "assurance", "label": "Delivery", "value": "COD nationwide" }
        },
        "a4": {
          "type": "row",
          "settings": { "panel": "assurance", "label": "Payment", "value": "Cash / bank / JazzCash" }
        }
      },
      "block_order": ["c1", "c2", "c3", "c4", "a1", "a2", "a3", "a4"],
      "settings": {}
    },
    "related": {
      "type": "umar-related",
      "settings": {}
    }
  },
  "order": ["main", "specs", "condition", "related"]
}
