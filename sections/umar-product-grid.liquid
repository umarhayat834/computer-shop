{%- liquid
  if section.settings.collection == blank
    assign collection = collections.all
  else
    assign collection = section.settings.collection
  endif
  assign products = collection.products
  assign collection_url = collection.url | default: routes.all_products_collection_url
-%}

<div class="u-section" id="lineup">
  <div class="u-wrap">
    <div class="u-sechead">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="u-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="u-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}
          <p>{{ section.settings.subtext }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="u-linkarrow" href="{{ collection_url }}">
          {{- section.settings.view_all_label | escape -}}
          {% render 'umar-icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    {%- if products.size > 0 -%}
      <div class="u-cards">
        {%- for product in products limit: section.settings.products_to_show -%}
          {%- liquid
            assign battery = product.metafields.health.battery.value | default: 0 | plus: 0
            assign condition = product.metafields.specs.condition.value
            assign cpu = product.metafields.specs.cpu.value | default: product.type
            assign ram = product.metafields.specs.ram.value
            assign storage = product.metafields.specs.storage.value
            assign anydesk = product.metafields.verify.anydesk_id.value
            assign on_sale = false
            if product.compare_at_price_max > product.price
              assign on_sale = true
            endif
            assign battery_label = battery | append: '%'
          -%}
          <article class="u-card">
            <div class="u-card__media">
              {%- if on_sale -%}
                <span class="u-card__badge u-card__badge--lime">
                  {% render 'umar-icon', name: 'flame' %}Save {{ product.compare_at_price_max | minus: product.price | times: 100.0 | divided_by: product.compare_at_price_max | round }}%
                </span>
              {%- elsif condition != blank -%}
                <span class="u-card__badge u-card__badge--lime">{{ condition }}</span>
              {%- endif -%}
              <span class="u-card__badge u-card__badge--glass u-card__badge--right">
                {%- if anydesk != blank -%}
                  {% render 'umar-icon', name: 'battery' %}{{ anydesk }}
                {%- else -%}
                  {% render 'umar-icon', name: 'wifi' %}AnyDesk ready
                {%- endif -%}
              </span>

              {%- if product.featured_media -%}
                {{
                  product.featured_media
                  | image_url: width: 720
                  | image_tag:
                    class: 'u-card__img',
                    loading: 'lazy',
                    widths: '300,420,540,720',
                    sizes: '(min-width: 990px) 30vw, (min-width: 620px) 45vw, 90vw',
                    alt: product.featured_media.alt
                }}
              {%- else -%}
                <span class="u-card__placeholder">{% render 'umar-icon', name: 'laptop' %}</span>
              {%- endif -%}
            </div>

            <div class="u-card__body">
              <div class="u-card__brand">
                <span>{{ product.vendor | default: 'UMAR' | escape }}</span>
                {%- if condition != blank -%}
                  <span class="u-cond"><i></i>{{ condition }}</span>
                {%- else -%}
                  <span class="u-cond"><i></i>Tested</span>
                {%- endif -%}
              </div>

              <h3 class="u-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>

              {%- if cpu != blank or ram != blank or storage != blank -%}
                <div class="u-card__chips">
                  {%- if cpu != blank -%}<span class="u-chip"><b>CPU</b> {{ cpu }}</span>{%- endif -%}
                  {%- if ram != blank -%}<span class="u-chip"><b>RAM</b> {{ ram }}</span>{%- endif -%}
                  {%- if storage != blank -%}<span class="u-chip"><b>SSD</b> {{ storage }}</span>{%- endif -%}
                </div>
              {%- endif -%}

              {%- if battery > 0 -%}
                <div class="u-card__meter">
                  <span>Battery</span>
                  <span class="u-bar"><i style="width: {{ battery | at_most: 100 }}%"></i></span>
                  <b>{{ battery_label }}</b>
                </div>
              {%- endif -%}

              <div class="u-card__price">
                <b>{{ product.price | money }}</b>
                {%- if on_sale -%}
                  <s>{{ product.compare_at_price_max | money }}</s>
                  <span class="u-save">Save {{ product.compare_at_price_max | minus: product.price | times: 100.0 | divided_by: product.compare_at_price_max | round }}%</span>
                {%- endif -%}
              </div>

              <div class="u-card__actions">
                <a class="u-btn u-btn--lime" href="{{ product.url }}">
                  Buy now
                  {% render 'umar-icon', name: 'arrow' %}
                </a>
                <a
                  class="u-btn u-btn--ghost"
                  href="{{ product.url }}"
                  aria-label="View {{ product.title | escape }}"
                >
                  {% render 'umar-icon', name: 'external' %}
                </a>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="u-cards">
        {%- for i in (1..3) -%}
          <article class="u-card">
            <div class="u-card__media">
              <span class="u-card__placeholder">{% render 'umar-icon', name: 'laptop' %}</span>
            </div>
            <div class="u-card__body">
              <div class="u-card__brand"><span>UMAR</span><span class="u-cond"><i></i>Tested</span></div>
              <h3 class="u-card__title">Add products to this collection</h3>
              <div class="u-card__chips">
                <span class="u-chip"><b>CPU</b> i7</span>
                <span class="u-chip"><b>RAM</b> 16 GB</span>
                <span class="u-chip"><b>SSD</b> 1 TB</span>
              </div>
              <div class="u-card__price"><b>{{ 89900 | money }}</b></div>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Umar product grid",
  "tag": "section",
  "class": "umar-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The lineup"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "In stock now. Spec'd honestly."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Every laptop below is tested, cleaned and photographed in our Lahore workshop. Open any unit to see full specs, battery health and its live AnyDesk ID."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View-all label",
      "default": "View all laptops"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Umar product grid"
    }
  ]
}
{% endschema %}
